{
  "name": "TRUE DETECTOR",
  "short_name": "TRUE DETECTOR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101827",
  "theme_color": "#101827",
  "lang": "es",
  "share_target": {
    "action": "./share-media",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "audio/*",
            "image/*",
            "video/*",
            ".opus",
            ".ogg",
            ".m4a",
            ".mp3",
            ".wav",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".mp4",
            ".mov",
            ".webm"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
